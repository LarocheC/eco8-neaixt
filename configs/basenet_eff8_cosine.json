{
    "_comment": "Wave 1 (gap-closing): same architecture as basenet_causal.json but COSINE LR to lr_min for a proper fine-tuning tail. Run with --accum_steps 2 to get the paper's effective batch 8 (numerically exact: all norms are per-sample). batch_size stays 4 (micro-batch) to fit 24 GB.",
    "num_gpus": 0,
    "batch_size": 4,
    "learning_rate": 0.001,
    "lr_min": 1e-05,
    "scheduler": "cosine",
    "adam_b1": 0.9,
    "adam_b2": 0.999,
    "lr_decay": 0.98,
    "seed": 1234,
    "sampling_rate": 16000,
    "segment_size": 32000,
    "n_fft": 400,
    "hop_size": 100,
    "win_size": 400,
    "compress_factor": 0.3,
    "base_channels": 32,
    "expand_ratio": 4,
    "attn_reduction": 4,
    "band_edges_hz": [
        0,
        1000,
        4000,
        8000
    ],
    "band_depths": [
        4,
        3,
        2
    ],
    "crn_freq": 16,
    "crn_hidden": 128,
    "dec_depth": 2,
    "causal": true,
    "loss": {
        "magnitude": 0.9,
        "phase": 0.3,
        "complex": 0.1,
        "time": 0.2,
        "consistency": 0.1
    },
    "gan": {
        "enabled": true,
        "metric_loss_lambda": 0.05
    },
    "num_workers": 4,
    "dist_config": {
        "dist_backend": "nccl",
        "dist_url": "tcp://localhost:54321",
        "world_size": 1
    }
}
