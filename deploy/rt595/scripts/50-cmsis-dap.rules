# NXP LPC-Link2 / CMSIS-DAP debug probe (VID 1fc9) — allow non-root access for pyocd.
# Install: sudo cp deploy/rt595/scripts/50-cmsis-dap.rules /etc/udev/rules.d/ &&
#          sudo udevadm control --reload && sudo udevadm trigger
SUBSYSTEM=="usb", ATTRS{idVendor}=="1fc9", MODE="0666"
KERNEL=="hidraw*", ATTRS{idVendor}=="1fc9", MODE="0666"
