# Copy to .env (gitignored) and fill in your MyST / ST Edge AI Developer Cloud login —
# the SAME account you used in the web GUI. The password is used only on first run;
# the client then caches a refresh-token JWT in ~/.stmai_token.
#
#   cp .env.example .env && $EDITOR .env
#
# 5 wrong passwords locks the account, so paste carefully.
STM32AI_USERNAME=you@example.com
STM32AI_PASSWORD=

# Optional: point at your stm32ai-modelzoo-services checkout (else auto-discovered
# as a sibling clone / ~/stm32ai-modelzoo-services).
# STM32AI_MODELZOO=/path/to/stm32ai-modelzoo-services

# Optional: corporate proxy / TLS bypass if the cloud client hits SSL errors.
# NO_SSL_VERIFY=1
# https_proxy=http://user:pass@host:port
